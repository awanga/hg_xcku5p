# DDR4 pin LOCs for the 2 x MT40A256M16GE-075E, 32-bit bus. Source: docs/external/hg_xcku5p_sch.pdf
# (sheets 2 and 6) via docs/hardware/schematic-pin-extract.csv. I/O standards, DCI and drive
# come from the ddr4_0 IP constraints, not from this file. Port names match the ddr4_0 IP.

set_property PACKAGE_PIN P26 [get_ports {c0_ddr4_adr[0]}]
set_property PACKAGE_PIN P25 [get_ports {c0_ddr4_adr[1]}]
set_property PACKAGE_PIN R22 [get_ports {c0_ddr4_adr[2]}]
