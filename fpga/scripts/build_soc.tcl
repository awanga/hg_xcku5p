# SPDX-License-Identifier: MIT
# Minimal SoC build: vivado -mode batch -source fpga/scripts/build_soc.tcl -tclargs <outdir> <soc_name> <tck_ps> <rom_hex> [-to synth|impl|bit]
# Optional: -strategy <impl strategy>.
# <soc_name> is a netlist generated by fpga/scripts/cpu/gen_soc.sh (build/soc/<soc_name>/<soc_name>.v).
# tck_ps: DDR4 clock period; the CPU runs on the controller user clock (tck/4): 750 -> 333.33 MHz (DDR4-2667), 1250 -> 200 MHz.
# A name containing "dma" or "l2" also defines WITH_DMA in soc_top.v.
set root [file normalize [file join [file dirname [info script]] .. ..]]
set outdir [file normalize [lindex $argv 0]]
set soc [lindex $argv 1]
set tck [lindex $argv 2]
set rom [file normalize [lindex $argv 3]]
set upto "bit"
set i [lsearch $argv "-to"]
if {$i >= 0} { set upto [lindex $argv [expr {$i + 1}]] }
set part xcku5p-ffvb676-2-i
set strategy ""
set i [lsearch $argv "-strategy"]
if {$i >= 0} { set strategy [lindex $argv [expr {$i + 1}]] }

create_project -force soc $outdir -part $part
create_ip -name ddr4 -vendor xilinx.com -library ip -module_name ddr4_0
set_property -dict [list \
    CONFIG.C0.DDR4_MemoryPart MT40A256M16GE-075E \
    CONFIG.C0.DDR4_DataWidth 32 \
    CONFIG.C0.DDR4_TimePeriod $tck \
    CONFIG.C0.DDR4_InputClockPeriod 10000 \
    CONFIG.C0.DDR4_AxiSelection true \
    CONFIG.C0.DDR4_AxiIDWidth 8 \
    CONFIG.C0.DDR4_DataMask DM_NO_DBI \
    CONFIG.C0.DDR4_EN_PARITY false] [get_ips ddr4_0]
create_ip -name axi_clock_converter -vendor xilinx.com -library ip -module_name cc_per
set_property -dict [list CONFIG.PROTOCOL AXI4LITE CONFIG.DATA_WIDTH 32 CONFIG.ADDR_WIDTH 32 CONFIG.ACLK_ASYNC 1] [get_ips cc_per]
create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name xbar_per
set_property -dict [list CONFIG.PROTOCOL AXI4LITE CONFIG.NUM_SI 1 CONFIG.NUM_MI 3 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 32 \
    CONFIG.M00_A00_BASE_ADDR 0x00000000F8000000 CONFIG.M00_A00_ADDR_WIDTH 12 \
    CONFIG.M01_A00_BASE_ADDR 0x00000000F8001000 CONFIG.M01_A00_ADDR_WIDTH 12 \
    CONFIG.M02_A00_BASE_ADDR 0x0000000010000000 CONFIG.M02_A00_ADDR_WIDTH 16] [get_ips xbar_per]
create_ip -name axi_uartlite -vendor xilinx.com -library ip -module_name uart_0
set_property -dict [list CONFIG.C_BAUDRATE 230400 CONFIG.C_S_AXI_ACLK_FREQ_HZ 100000000] [get_ips uart_0]
generate_target all [get_ips]

add_files [list $root/fpga/rtl/soc_top.v $root/fpga/rtl/axil_simple.v $root/fpga/rtl/boot_rom.v \
    $root/fpga/rtl/soc_regs.v $root/fpga/rtl/vexii_ram.v $root/build/soc/$soc/$soc.v]
add_files -fileset constrs_1 [list $root/fpga/constraints/ddr4_pins.xdc $root/fpga/constraints/bringup_board.xdc \
    $root/fpga/constraints/soc_board.xdc]
set defs [list SOC_MODULE=$soc]
if {[string match "*dma*" $soc] || [string match "*l2*" $soc]} { lappend defs WITH_DMA }
set_property verilog_define $defs [get_filesets sources_1]
set_property top soc_top [current_fileset]
set_property generic [list CPU_KHZ=[expr {int(250000000.0 / $tck)}] ROM_INIT=\"$rom\"] [current_fileset]
if {$strategy ne ""} { set_property strategy $strategy [get_runs impl_1] }
update_compile_order -fileset sources_1

proc run_to {name step} {
    launch_runs $name -to_step $step -jobs 8
    wait_on_run $name
    set st [get_property STATUS [get_runs $name]]
    puts "RUN $name: $st"
    if {![string match "*Complete*" $st]} { error "$name failed: $st" }
}
run_to synth_1 synth_design
open_run synth_1
report_utilization -file $outdir/synth_utilization.rpt
close_design
if {$upto eq "synth"} { puts "BUILD_DONE synth"; exit 0 }
set_property STEPS.WRITE_BITSTREAM.TCL.PRE {} [get_runs impl_1]
# Strategies with a post-route phys_opt step need the run taken past route_design to be openable.
launch_runs impl_1 -to_step [expr {$strategy eq "" ? "route_design" : "phys_opt_design (Post-Route)"}] -jobs 8
wait_on_run impl_1
puts "RUN impl_1: [get_property STATUS [get_runs impl_1]]"
open_run impl_1
report_utilization -file $outdir/impl_utilization.rpt
report_timing_summary -file $outdir/impl_timing.rpt
report_drc -file $outdir/impl_drc.rpt
report_clock_utilization -file $outdir/impl_clocks.rpt
report_clock_interaction -file $outdir/impl_clock_interaction.rpt
puts "WNS [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1]]"
if {$upto eq "bit"} { write_bitstream -force $outdir/soc.bit }
puts "BUILD_DONE $upto"
