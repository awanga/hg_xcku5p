# SPDX-License-Identifier: MIT
# Minimal SoC build: vivado -mode batch -source fpga/scripts/build_soc.tcl -tclargs <outdir> <soc_name> <tck_ps> <rom_hex> [-to synth|impl|bit]
# Optional: -strategy <impl strategy>.
# <soc_name> is a netlist generated by fpga/scripts/cpu/gen_soc.sh (build/soc/<soc_name>/<soc_name>.v).
# tck_ps: DDR4 clock period; the CPU runs on the controller user clock (tck/4): 750 -> 333.33 MHz (DDR4-2667), 1250 -> 200 MHz.
# Optional: -ddr8g builds the controller for 8 Gb x16 chips (MT40A512M16HA-075E, 2 GiB) and defines DDR_8G: the DDR4 capacity test (DDRHALF register).
# A name containing "dma" or "l2" also defines WITH_DMA in soc_top.v.
# Optional: -nocpu builds the CPU-less variant (decision 0008, variant 3): soc_name is ignored (use nocpu), no CPU netlist; the UART2 test rig drives the buses.
# Optional: -card builds the lean CPU-less PCIe card (fpga/rtl/card_top.v): DDR4 + PCIe endpoint + UART2 rig + card_regs/user_regs, no other peripherals (implies -nocpu -pcie).
# Optional: -vpcie adds the logical PCIe root-complex window (docs/decisions/0008; netlist from gen_vpcie_soc.sh). -pcie adds the PCIe endpoint (XDMA core, window filter, registers at 0xF800A000; needs WITH_DMA) and the shared hub DMA port crossbar.
set root [file normalize [file join [file dirname [info script]] .. ..]]
set outdir [file normalize [lindex $argv 0]]
set soc [lindex $argv 1]
set tck [lindex $argv 2]
set rom [file normalize [lindex $argv 3]]
set upto "bit"
set i [lsearch $argv "-to"]
if {$i >= 0} { set upto [lindex $argv [expr {$i + 1}]] }
set part xcku5p-ffvb676-2-i
set strategy ""
set ddr_part MT40A256M16GE-075E
set ddr8g [expr {[lsearch $argv "-ddr8g"] >= 0}]
set pcie [expr {[lsearch $argv "-pcie"] >= 0}]
set vpcie [expr {[lsearch $argv "-vpcie"] >= 0}]
set card [expr {[lsearch $argv "-card"] >= 0}]
# -umem N: number of user DDR4 master ports of the card build (user_ip), 1..15 (default 2); -uirq N: user interrupt lines to the host, 1..6 (default 6)
set umem 2
set i [lsearch $argv "-umem"]
if {$i >= 0} { set umem [lindex $argv [expr {$i + 1}]] }
set uirq 6
set i [lsearch $argv "-uirq"]
if {$i >= 0} { set uirq [lindex $argv [expr {$i + 1}]] }
if {$card && (![string is integer -strict $umem] || $umem < 1 || $umem > 15)} { error "-umem N needs 1..15 (crossbar of 1 + N slaves, ids of at most 8 bits)" }
if {$card && (![string is integer -strict $uirq] || $uirq < 1 || $uirq > 6)} { error "-uirq N needs 1..6 (XDMA user interrupt vectors 2..7)" }
set nocpu [expr {[lsearch $argv "-nocpu"] >= 0 || $card}]
if {$card} { set pcie 1 }
if {$card && $vpcie} { error "-card and -vpcie are different variants (docs/decisions/0008)" }
if {$nocpu && $vpcie} { error "-nocpu and -vpcie are different variants (docs/decisions/0008)" }
if {$pcie && $vpcie} { error "-pcie and -vpcie are different variants (docs/decisions/0008)" }
if {$vpcie && ![string match "*w4v" $soc]} { error "-vpcie needs the netlist with the 2 MiB peripheral region at 0xF9000000 (fpga/scripts/cpu/gen_vpcie_soc.sh, name ending w4v)" }
if {$ddr8g} { set ddr_part MT40A512M16HA-075E }
set i [lsearch $argv "-strategy"]
if {$i >= 0} { set strategy [lindex $argv [expr {$i + 1}]] }

create_project -force soc $outdir -part $part
create_ip -name ddr4 -vendor xilinx.com -library ip -module_name ddr4_0
set_property -dict [list \
    CONFIG.C0.DDR4_MemoryPart $ddr_part \
    CONFIG.C0.DDR4_DataWidth 32 \
    CONFIG.C0.DDR4_TimePeriod $tck \
    CONFIG.C0.DDR4_InputClockPeriod 10000 \
    CONFIG.C0.DDR4_AxiSelection true \
    CONFIG.C0.DDR4_AxiIDWidth 8 \
    CONFIG.C0.DDR4_DataMask DM_NO_DBI \
    CONFIG.C0.DDR4_EN_PARITY false] [get_ips ddr4_0]
create_ip -name axi_clock_converter -vendor xilinx.com -library ip -module_name cc_per
set_property -dict [list CONFIG.PROTOCOL AXI4LITE CONFIG.DATA_WIDTH 32 CONFIG.ADDR_WIDTH 32 CONFIG.ACLK_ASYNC 1] [get_ips cc_per]
if {!$card} {
create_ip -name axi_clock_converter -vendor xilinx.com -library ip -module_name cc_dma
set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.DATA_WIDTH 64 CONFIG.ADDR_WIDTH 32 CONFIG.ID_WIDTH 4 CONFIG.ACLK_ASYNC 1 \
    CONFIG.READ_WRITE_MODE WRITE_ONLY] [get_ips cc_dma]
create_ip -name axi_clock_converter -vendor xilinx.com -library ip -module_name cc_dmar
set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.DATA_WIDTH 64 CONFIG.ADDR_WIDTH 32 CONFIG.ID_WIDTH 4 CONFIG.ACLK_ASYNC 1 \
    CONFIG.READ_WRITE_MODE READ_ONLY] [get_ips cc_dmar]
create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name xbar_per
set_property -dict [list CONFIG.PROTOCOL AXI4LITE CONFIG.NUM_SI 2 CONFIG.NUM_MI 13 CONFIG.ADDR_RANGES 2 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 32 \
    CONFIG.M00_A00_BASE_ADDR 0x00000000F8000000 CONFIG.M00_A00_ADDR_WIDTH 12 \
    CONFIG.M01_A00_BASE_ADDR 0x00000000F8001000 CONFIG.M01_A00_ADDR_WIDTH 12 \
    CONFIG.M02_A00_BASE_ADDR 0x0000000010000000 CONFIG.M02_A00_ADDR_WIDTH 16 \
    CONFIG.M03_A00_BASE_ADDR 0x00000000F8002000 CONFIG.M03_A00_ADDR_WIDTH 12 \
    CONFIG.M04_A00_BASE_ADDR 0x00000000F8008000 CONFIG.M04_A00_ADDR_WIDTH 13 \
    CONFIG.M04_A01_BASE_ADDR 0x00000000F800C000 CONFIG.M04_A01_ADDR_WIDTH 13 \
    CONFIG.M05_A00_BASE_ADDR 0x00000000F8003000 CONFIG.M05_A00_ADDR_WIDTH 12 \
    CONFIG.M06_A00_BASE_ADDR 0x00000000F8004000 CONFIG.M06_A00_ADDR_WIDTH 12 \
    CONFIG.M07_A00_BASE_ADDR 0x00000000F8005000 CONFIG.M07_A00_ADDR_WIDTH 12 \
    CONFIG.M08_A00_BASE_ADDR 0x00000000F8006000 CONFIG.M08_A00_ADDR_WIDTH 12 \
    CONFIG.M09_A00_BASE_ADDR 0x00000000F8007000 CONFIG.M09_A00_ADDR_WIDTH 12 \
    CONFIG.M10_A00_BASE_ADDR 0x00000000F800E000 CONFIG.M10_A00_ADDR_WIDTH 12 \
    CONFIG.M11_A00_BASE_ADDR 0x00000000F800F000 CONFIG.M11_A00_ADDR_WIDTH 12 \
    CONFIG.M12_A00_BASE_ADDR 0x00000000F800A000 CONFIG.M12_A00_ADDR_WIDTH 12] [get_ips xbar_per]
if {$nocpu && $pcie} {
    # the host's BAR0 is a third master of the peripheral crossbar
    set_property CONFIG.NUM_SI 3 [get_ips xbar_per]
}
if {$vpcie} {
    # logical PCIe device window (ECAM + BAR memory), 2 MiB
    set_property -dict [list CONFIG.NUM_MI 14 CONFIG.M13_A00_BASE_ADDR 0x00000000F9000000 CONFIG.M13_A00_ADDR_WIDTH 21] [get_ips xbar_per]
}
create_ip -name axi_uartlite -vendor xilinx.com -library ip -module_name uart_0
set_property -dict [list CONFIG.C_BAUDRATE 230400 CONFIG.C_S_AXI_ACLK_FREQ_HZ 100000000] [get_ips uart_0]
# AXI GPIO (DS18B20 1-Wire, buzzer, fan tach) and AXI Timer (fan PWM): both have upstream Linux drivers (gpio-xilinx, pwm-xilinx).
create_ip -name axi_gpio -vendor xilinx.com -library ip -module_name gpio_0
set_property -dict [list CONFIG.C_GPIO_WIDTH 19 CONFIG.C_ALL_INPUTS 0 CONFIG.C_ALL_OUTPUTS 0 CONFIG.C_INTERRUPT_PRESENT 1 \
    CONFIG.C_DOUT_DEFAULT 0x00000000 CONFIG.C_TRI_DEFAULT 0xFFFFFFFF] [get_ips gpio_0]
create_ip -name axi_timer -vendor xilinx.com -library ip -module_name tmr_0
create_ip -name axi_iic -vendor xilinx.com -library ip -module_name iic_0
set_property -dict [list CONFIG.AXI_ACLK_FREQ_MHZ 100 CONFIG.IIC_FREQ_KHZ 100] [get_ips iic_0]
}
if {$card} {
    # register crossbar of the card: SI0 = UART rig (through cc_per), SI1 = host BAR0; MI0 card_regs, MI1 user_regs, MI2 pcie_regs (4 KiB each), MI3 user_ip (16 KiB)
    create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name xbar_card
    set_property -dict [list CONFIG.PROTOCOL AXI4LITE CONFIG.NUM_SI 2 CONFIG.NUM_MI 4 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 32 \
        CONFIG.M00_A00_BASE_ADDR 0x00000000F8001000 CONFIG.M00_A00_ADDR_WIDTH 12 \
        CONFIG.M01_A00_BASE_ADDR 0x00000000F8002000 CONFIG.M01_A00_ADDR_WIDTH 12 \
        CONFIG.M02_A00_BASE_ADDR 0x00000000F800A000 CONFIG.M02_A00_ADDR_WIDTH 12 \
        CONFIG.M03_A00_BASE_ADDR 0x00000000F8004000 CONFIG.M03_A00_ADDR_WIDTH 14] [get_ips xbar_card]
}
if {$card} {
    # memory crossbar of the card: SI0 = rig and PCIe DMA (nocpu_core), SI1..N = user ports (user_ip); one master, the DDR4 controller; 256-bit, 4-bit slave ids
    create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name xbar_mem
    set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.NUM_SI [expr {1 + $umem}] CONFIG.NUM_MI 1 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 256 CONFIG.ID_WIDTH 4 \
        CONFIG.M00_A00_BASE_ADDR 0x0000000000000000 CONFIG.M00_A00_ADDR_WIDTH 32] [get_ips xbar_mem]
}
if {$vpcie} {
    # the DMA engine's clock converter (per_clk -> CPU clock) and the shared hub DMA port crossbar (SI2 = the engine)
    create_ip -name axi_clock_converter -vendor xilinx.com -library ip -module_name vdma_cc
    set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.DATA_WIDTH 64 CONFIG.ADDR_WIDTH 32 CONFIG.ID_WIDTH 4 CONFIG.ACLK_ASYNC 1] [get_ips vdma_cc]
    create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name xbar_dma
    set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.NUM_SI 3 CONFIG.NUM_MI 1 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 64 CONFIG.ID_WIDTH 2 \
        CONFIG.M00_A00_BASE_ADDR 0x0000000000000000 CONFIG.M00_A00_ADDR_WIDTH 32] [get_ips xbar_dma]
}
if {$nocpu} {
    # CPU-less memory path (fpga/rtl/nocpu_core.v): hub DMA port 64 -> 256 bit, then a 2-slave crossbar (UART rig, DMA port) into the DDR4 controller
    create_ip -name axi_dwidth_converter -vendor xilinx.com -library ip -module_name nc_dw
    set_property -dict [list CONFIG.ADDR_WIDTH 32 CONFIG.SI_DATA_WIDTH 64 CONFIG.MI_DATA_WIDTH 256 CONFIG.SI_ID_WIDTH 4 CONFIG.PROTOCOL AXI4 \
        CONFIG.ACLK_ASYNC 0] [get_ips nc_dw]
    create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name nc_xbar
    set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.NUM_SI 2 CONFIG.NUM_MI 1 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 256 CONFIG.ID_WIDTH 1 \
        CONFIG.M00_A00_BASE_ADDR 0x0000000000000000 CONFIG.M00_A00_ADDR_WIDTH 32] [get_ips nc_xbar]
}
if {$pcie} {
    if {!($nocpu || [string match "*dma*" $soc] || [string match "*l2*" $soc])} { error "-pcie needs a SoC netlist with the DMA port (name containing dma or l2)" }
    source $root/fpga/scripts/pcie/xdma_ip.tcl
    file mkdir [file join $outdir soc.srcs sources_1 ip]
    make_xdma xdma_0 [file join $outdir soc.srcs sources_1 ip] 0
    make_pcie_converters
    # shared hub DMA port: SI0 eth_dma (writes), SI1 HDMI (reads), SI2 PCIe; one 64-bit slave covering the whole address space
    if {!$card} {
        create_ip -name axi_crossbar -vendor xilinx.com -library ip -module_name xbar_dma
        set_property -dict [list CONFIG.PROTOCOL AXI4 CONFIG.NUM_SI 3 CONFIG.NUM_MI 1 CONFIG.ADDR_WIDTH 32 CONFIG.DATA_WIDTH 64 CONFIG.ID_WIDTH 2 \
            CONFIG.M00_A00_BASE_ADDR 0x0000000000000000 CONFIG.M00_A00_ADDR_WIDTH 32] [get_ips xbar_dma]
    }
}
generate_target all [get_ips]
if {$pcie} {
    # the PCIe core must carry the identity of fpga/pcie_identity.cfg (what the host enumerates after a flash boot)
    if {[catch {exec python3 $root/tools/pcie_identity.py check-ip $outdir/soc.gen/sources_1/ip} idout]} { error "PCIe identity check failed:\n$idout" }
    puts "PCIE_IDENTITY $idout"
}

set liteeth $root/build/liteeth/gateware/liteeth_core.v
if {!$card && ![file exists $liteeth]} { error "missing $liteeth: run fpga/scripts/gen_liteeth.sh" }
if {$card} {
    add_files [list $root/fpga/rtl/card_top.v $root/fpga/rtl/card_regs.v $root/fpga/rtl/user_regs.v $root/fpga/rtl/user_ip.v $root/fpga/rtl/mem_probe.v $root/fpga/rtl/axil_simple.v $root/fpga/rtl/irq_sync.v]
} else {
add_files [list $root/fpga/rtl/soc_top.v $root/fpga/rtl/axil_simple.v $root/fpga/rtl/boot_rom.v \
    $root/fpga/rtl/soc_regs.v $root/fpga/rtl/spi_sifive.v $root/fpga/rtl/eth_addr_map.v $root/fpga/rtl/irq_pulse.v $root/fpga/rtl/irq_sync.v $root/fpga/rtl/gmii_rx_reg.v $root/fpga/rtl/drp_reader.v $root/fpga/rtl/ddr_halfmap.v $root/fpga/rtl/board_gpio_map.v $root/fpga/rtl/irq_hold.v $root/fpga/rtl/eth_dma.v $root/fpga/rtl/hdmi_out.v $root/fpga/rtl/hdmi_timing.v $root/fpga/rtl/hdmi_fetch.v $root/fpga/rtl/hdmi_linebuf.v $root/fpga/rtl/tmds_encoder.v $root/fpga/rtl/tmds_ser.v $root/fpga/rtl/clk_freq_meter.v \
    $liteeth]
}
if {$nocpu} {
    add_files [list $root/fpga/rtl/nocpu_core.v $root/fpga/rtl/uart_rig.v $root/fpga/rtl/uart_rx.v $root/fpga/rtl/uart_tx.v]
    add_files -fileset constrs_1 $root/fpga/constraints/nocpu.xdc
} else {
    add_files [list $root/fpga/rtl/vexii_ram.v $root/build/soc/$soc/$soc.v]
}
if {$card} {
    add_files -fileset constrs_1 [list $root/fpga/constraints/ddr4_pins.xdc $root/fpga/constraints/card_board.xdc]
} else {
    add_files -fileset constrs_1 [list $root/fpga/constraints/ddr4_pins.xdc $root/fpga/constraints/bringup_board.xdc \
        $root/fpga/constraints/soc_board.xdc]
}
if {$pcie} {
    add_files [list $root/fpga/rtl/pcie_ep.v $root/fpga/rtl/irq_req.v $root/fpga/rtl/pcie_regs.v $root/fpga/rtl/axi_win.v $root/fpga/rtl/cdc_cfg.v]
    add_files -fileset constrs_1 $root/fpga/constraints/pcie.xdc
}
if {$vpcie} {
    add_files [list $root/fpga/rtl/vpcie_ep.v $root/fpga/rtl/vpcie.v $root/fpga/rtl/vdma.v $root/fpga/rtl/pcie_regs.v]
}
set defs [list SOC_MODULE=$soc]
if {$vpcie} { lappend defs WITH_VPCIE }
if {$pcie} { lappend defs WITH_PCIE }
if {$nocpu} { lappend defs NOCPU WITH_DMA }
if {$card} { lappend defs CARD }
if {!$nocpu && ([string match "*dma*" $soc] || [string match "*l2*" $soc])} { lappend defs WITH_DMA }
if {$ddr8g} { lappend defs DDR_8G }
set_property verilog_define $defs [get_filesets sources_1]
if {$card} {
    # version and commit id from the source tree; identity words from the manifest
    set fh [open $root/VERSION r]; set ver [string trim [read $fh]]; close $fh
    lassign [split $ver .] vmaj vmin vpat
    set build 0
    catch {set build [expr {"0x[exec git -C $root rev-parse --short=8 HEAD]"}]}
    set idg [exec python3 $root/tools/pcie_identity.py generics]
    set_property top card_top [current_fileset]
    set_property generic [concat [list UMEM=$umem UIRQ=$uirq CARD_VERSION=32'h[format %08X [expr {($vmaj << 16) | ($vmin << 8) | $vpat}]] CARD_BUILD=32'h[format %08X $build]] $idg] [current_fileset]
} else {
set_property top soc_top [current_fileset]
set_property generic [list CPU_KHZ=[expr {int(250000000.0 / $tck)}] ROM_INIT=\"$rom\"] [current_fileset]
}
if {$strategy ne ""} { set_property strategy $strategy [get_runs impl_1] }
update_compile_order -fileset sources_1

proc run_to {name step} {
    launch_runs $name -to_step $step -jobs 8
    wait_on_run $name
    set st [get_property STATUS [get_runs $name]]
    puts "RUN $name: $st"
    if {![string match "*Complete*" $st]} { error "$name failed: $st" }
}
run_to synth_1 synth_design
open_run synth_1
report_utilization -file $outdir/synth_utilization.rpt
close_design
if {$upto eq "synth"} { puts "BUILD_DONE synth"; exit 0 }
set_property STEPS.WRITE_BITSTREAM.TCL.PRE {} [get_runs impl_1]
# A run whose strategy enables post-route phys_opt must be taken through it to be openable.
set last_step route_design
if {[get_property STEPS.POST_ROUTE_PHYS_OPT_DESIGN.IS_ENABLED [get_runs impl_1]]} { set last_step "phys_opt_design (Post-Route)" }
launch_runs impl_1 -to_step $last_step -jobs 8
wait_on_run impl_1
puts "RUN impl_1: [get_property STATUS [get_runs impl_1]]"
open_run impl_1
report_utilization -file $outdir/impl_utilization.rpt
report_timing_summary -file $outdir/impl_timing.rpt
report_drc -file $outdir/impl_drc.rpt
report_clock_utilization -file $outdir/impl_clocks.rpt
report_clock_interaction -file $outdir/impl_clock_interaction.rpt
puts "WNS [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1]]"
if {$upto eq "bit"} { write_bitstream -force $outdir/soc.bit }
# Archive a summary (tool version, source commit, WNS/WHS, utilization, DRC) next to the reports; slack is only reported here,
# tools/build_report.py without the flag is the pass/fail gate.
catch {exec python3 $root/tools/build_report.py $outdir --allow-negative-slack} rep
puts "REPORT $rep"
puts "BUILD_DONE $upto"
