// SPDX-License-Identifier: MIT
/*
 * HG-XCKU5P minimal SoC (included by hg-xcku5p.dts and hg-xcku5p-sdroot.dts): VexiiRiscv RV64IMA (no C/F/D), CPU on the DDR4 user clock.
 * Memory map is fixed by fpga/rtl/soc_top.v and fpga/scripts/cpu/gen_soc.sh; keep them consistent.
 * The first MiB of DDR4 holds the ROM loader's stack until OpenSBI takes over at 0x40100000.
 */
/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "hamgeek,hg-xcku5p", "vexiiriscv";
	model = "HG-XCKU5P VexiiRiscv";

	chosen {
		stdout-path = "serial0:230400n8";
	};

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <333333333>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "spinalhdl,vexiiriscv", "riscv";
			reg = <0>;
			riscv,isa = "rv64ima_zicsr_zifencei";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
			mmu-type = "riscv,sv39";
			status = "okay";

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	per_clk: clock-100m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	/* flags 6 = GPIO_OPEN_DRAIN (single ended, open drain) */
	onewire {
		compatible = "w1-gpio";
		gpios = <&gpio 0 6>;
	};

	beeper {
		compatible = "gpio-beeper";
		gpios = <&gpio 1 0>;
	};

	/* 4-wire fan: PWM 25 kHz, tach 2 pulses per revolution on the GPIO interrupt (falling edge) */
	fan {
		compatible = "pwm-fan";
		pwms = <&pwm 0 40000 0>;
		interrupt-parent = <&gpio>;
		interrupts = <2 2>;
		pulses-per-revolution = <2>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x40000000>;
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		clint: timer@f0010000 {
			compatible = "sifive,clint0", "riscv,clint0";
			reg = <0xf0010000 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
		};

		plic: interrupt-controller@f0c00000 {
			compatible = "sifive,plic-1.0.0", "riscv,plic0";
			reg = <0xf0c00000 0x400000>;
			#interrupt-cells = <1>;
			#address-cells = <0>;
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 11>, <&cpu0_intc 9>;
			riscv,ndev = <31>;
		};

		/* SD card socket in SPI mode through the SiFive-compatible master (fpga/rtl/spi_sifive.v) */
		spi0: spi@f8002000 {
			compatible = "sifive,spi0";
			reg = <0xf8002000 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <2>;
			clocks = <&per_clk>;
			#address-cells = <1>;
			#size-cells = <0>;
			sifive,fifo-depth = <8>;
			sifive,max-bits-per-word = <8>;

			mmc@0 {
				compatible = "mmc-spi-slot";
				reg = <0>;
				spi-max-frequency = <25000000>;
				voltage-ranges = <3300 3300>;
				non-removable;
			};
		};

		/* MS5611 barometer on its own SiFive-compatible SPI master (SPI mode 0, <= 20 MHz per the datasheet) */
		spi1: spi@f8005000 {
			compatible = "sifive,spi0";
			reg = <0xf8005000 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <4>;
			clocks = <&per_clk>;
			#address-cells = <1>;
			#size-cells = <0>;
			sifive,fifo-depth = <8>;
			sifive,max-bits-per-word = <8>;

			barometer@0 {
				compatible = "meas,ms5611";
				reg = <0>;
				spi-max-frequency = <10000000>;
			};
		};

		/* AXI GPIO: 0 DS18B20 1-Wire (open drain, 4.7 k pull-up on the board), 1 buzzer (active high), 2 fan tach input */
		gpio: gpio@f8003000 {
			compatible = "xlnx,xps-gpio-1.00.a";
			reg = <0xf8003000 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <5>;
			interrupt-controller;
			#interrupt-cells = <2>;
			gpio-controller;
			#gpio-cells = <2>;
			xlnx,gpio-width = <3>;
			xlnx,is-dual = <0>;
			xlnx,all-inputs = <0>;
			xlnx,all-outputs = <0>;
			xlnx,dout-default = <0>;
			xlnx,tri-default = <0xffffffff>;
			xlnx,interrupt-present = <1>;
		};

		/* AXI Timer in PWM mode; fpga/rtl/soc_top.v inverts its output for the fan's NMOS driver, so the fan sees this duty directly */
		pwm: pwm@f8004000 {
			compatible = "xlnx,xps-timer-1.00.a";
			reg = <0xf8004000 0x1000>;
			clocks = <&per_clk>;
			clock-names = "s_axi_aclk";
			#pwm-cells = <3>;
			xlnx,count-width = <32>;
			xlnx,one-timer-only = <0>;
		};

		/*
		 * LiteEth MAC (fpga/ip/liteeth/liteeth_gmii.yml) behind the RTL8211EG in GMII mode. MDC/MDIO are not wired, so there is
		 * no PHY node: the driver does not use phylib and the link is whatever the PHY auto-negotiates. The MAC address is a
		 * locally administered default; a bootloader or the user should override it when more than one board shares a LAN.
		 */
		eth0: ethernet@f8009000 {
			compatible = "litex,liteeth";
			reg = <0xf8009000 0x100>, <0xf8008800 0x100>, <0xf800c000 0x2000>;
			reg-names = "mac", "mdio", "buffer";
			interrupt-parent = <&plic>;
			interrupts = <3>;
			litex,rx-slots = <2>;
			litex,tx-slots = <2>;
			litex,slot-size = <0x800>;
			local-mac-address = [02 48 47 4b 55 35];
		};

		uart0: serial@f8000000 {
			compatible = "xlnx,xps-uartlite-1.00.a";
			reg = <0xf8000000 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <1>;
			current-speed = <230400>;
			clock-frequency = <100000000>;
			xlnx,baudrate = <230400>;
			xlnx,data-bits = <8>;
			xlnx,use-parity = <0>;
		};
	};
};
