# SPDX-License-Identifier: MIT
# Applied on top of arch/riscv defconfig (scripts/kconfig/merge_config.sh): RV64IMA without C/F/D, one hart, UART lite console,
# embedded initramfs. Kept small because the image is loaded over a 230400 baud UART.
CONFIG_RISCV_ISA_C=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_V=n
CONFIG_SMP=n
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_EFI=n
CONFIG_KEXEC=n
CONFIG_PERF_EVENTS=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_SERIAL_UARTLITE=y
CONFIG_SERIAL_UARTLITE_CONSOLE=y
CONFIG_SERIAL_UARTLITE_NR_UARTS=1
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_8250=n
CONFIG_VIRTIO_MENU=n
CONFIG_PCI=n
CONFIG_DRM=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_INITRAMFS_COMPRESSION_NONE=y
