# Buildroot rootfs + cross toolchain for the VexiiRiscv RV64IMA (no C/F/D) SoC. The kernel and OpenSBI are built outside Buildroot.
BR2_riscv=y
BR2_RISCV_64=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ABI_LP64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TARGET_GENERIC_HOSTNAME="hg-xcku5p"
BR2_TARGET_GENERIC_ISSUE="HG-XCKU5P (VexiiRiscv RV64IMA)"
BR2_TARGET_GENERIC_GETTY_PORT="ttyUL0"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_ROOTFS_CPIO=y
# BR2_TARGET_ROOTFS_CPIO_GZIP is not set
BR2_TARGET_ROOTFS_CPIO_NONE=y
BR2_ROOTFS_POST_BUILD_SCRIPT="/home/awanga/hg_xcku5p/linux/buildroot/post-build.sh"
